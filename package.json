{
  "name": "cryptotracker",
  "version": "1.0.0",
  "private": true,
  "description": "Personal cryptocurrency lists.",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && jest --runInBand",
    "test:coverage": "npm test -- --coverage",
    "check": "npm run build && npm run test:coverage"
  },
  "dependencies": {
    "axios": "1.20.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "sqlite3": "6.0.1",
    "swagger-ui-dist": "5.34.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-dist": "3.30.6",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
